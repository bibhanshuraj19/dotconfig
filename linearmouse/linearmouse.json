{
  "$schema" : "https:\/\/schema.linearmouse.app\/0.10.2",
  "schemes" : [
    {
      "buttons" : {
        "mappings" : [
          {
            "action" : {
              "run" : "# Toggle between current and previous app\nosascript -e 'tell application \"System Events\" to key code 48 using command down'"
            },
            "button" : 4,
            "command" : false,
            "control" : false,
            "option" : false,
            "shift" : false
          }
        ],
        "universalBackForward" : true
      },
      "if" : {
        "device" : {
          "category" : "mouse",
          "productID" : "0x6621",
          "productName" : "Epic M2",
          "vendorID" : "0x32c2"
        }
      },
      "scrolling" : {
        "acceleration" : {
          "vertical" : 1
        },
        "distance" : {
          "vertical" : "auto"
        },
        "modifiers" : {
          "vertical" : {
            "command" : {
              "type" : "preventDefault"
            }
          }
        },
        "reverse" : {
          "vertical" : true
        },
        "speed" : {
          "vertical" : 0
        }
      }
    }
  ]
}